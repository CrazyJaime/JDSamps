{
  "name": "Movie Maker",
  "short_name": "Movie Maker",
  "description": "A fan-made, browser-based re-creation of the classic Windows Live Movie Maker. Edit videos, photos, music, titles and captions right on your device — nothing is uploaded.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "theme_color": "#c9dcf2",
  "background_color": "#e6eff9",
  "lang": "en",
  "dir": "ltr",
  "categories": ["photo", "entertainment", "productivity"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/apple-touch-icon.png", "sizes": "180x180", "type": "image/png", "purpose": "any" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "media",
          "accept": [
            "video/*", "image/*", "audio/*",
            ".mp4", ".m4v", ".mov", ".webm", ".mkv", ".3gp",
            ".jpg", ".jpeg", ".png", ".gif", ".webp", ".heic", ".heif",
            ".mp3", ".m4a", ".aac", ".wav", ".ogg", ".opus", ".flac",
            ".wlmmweb"
          ]
        }
      ]
    }
  }
}
